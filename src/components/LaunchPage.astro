---
import { Picture } from 'astro:assets';
import forest from '../assets/forest.jpg';
import portrait from '../assets/riccardo-vittori.jpg';
import { href, absolute } from '../lib/urls';
import { launchContact } from '../config/launch';
import '../styles/fonts.css';
import '../styles/launch.css';
const ready = Boolean(launchContact.whatsapp || launchContact.email);
const interests = [
  'Degustazioni, gastronomia e arte',
  'FLOW Immersive — 2–3 giorni',
  'Nature Experience — uscita sociale',
  'Private Truffle Experience',
  'Tartufo fresco su ordinazione',
  'Lezioni arti marziali',
  'Ospitare un’esperienza',
  'Sponsor e collaborazioni',
  'Docenti e professionisti',
  'Partner ambientali',
];
const title = 'FLOW — Feel Your HeART | Riccardo Vittori';
const description =
  'Feel Your HeART. Presenza, espressione e connessione: la filosofia di Riccardo Vittori prende forma in esperienze fra natura, corpo e conoscenza.';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute()} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f5f1e8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute()} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={absolute('social.jpg')} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'FLOW',
        url: absolute(),
        creator: { '@type': 'Person', name: 'Riccardo Vittori' },
      }).replace(/</g, '\\u003c')}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Vai al contenuto
    </a>
    <header class="shell launch-header">
      <a class="brand" href={href()} aria-label="FLOW, homepage">
        FLOW<span>di Riccardo Vittori</span>
      </a>
      <nav class="wide-nav" aria-label="Navigazione principale">
        <a href="#esperienze">Experiences</a>
        <a href="#percorsi">Immersive</a>
        <a href="#servizi">Tartufo e lezioni</a>
        <a href="#collabora">Collabora</a>
      </nav>
      <a class="header-contact" href="#contatti">
        Cominciamo ↗
      </a>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav aria-label="Navigazione mobile">
          <a href="#esperienze">Experiences</a>
          <a href="#percorsi">Immersive</a>
          <a href="#servizi">Tartufo e lezioni</a>
          <a href="#collabora">Collabora</a>
          <a href={href('esplora/')}>Taccuino</a>
        </nav>
      </details>
    </header>
    <main id="main" data-pagefind-body>
      <section class="hero shell">
        <div>
          <p class="eyebrow">PRESENZA · ESPRESSIONE · CONNESSIONE</p>
          <h1>
            Feel Your
            <br />
            <em>HeART.</em>
          </h1>
          <p class="intro">
            Essere pienamente dentro ciò che fai. Ascoltare ciò che senti e
            dargli una forma tua. FLOW nasce per esplorare questa possibilità
            attraverso la natura, il corpo, la creazione e l’incontro.
          </p>
          <div class="actions">
            <a class="button primary" href="#esperienze">
              Trova la tua esperienza ↘
            </a>
            <a class="text-link" href="#riccardo">
              Conosci Riccardo ↗
            </a>
          </div>
          <p class="small hero-note">
            Dentro HeART c’è ART: l’arte di esprimere ciò che portiamo nel
            cuore.
          </p>
        </div>
        <figure>
          <Picture
            src={forest}
            alt="La luce attraversa gli alberi nel bosco"
            formats={['avif', 'webp']}
            widths={[600, 1000, 1400]}
            sizes="(max-width:760px) 100vw, 55vw"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>Una curiosità diventa un’esperienza.</figcaption>
        </figure>
      </section>
      <div class="shell manifesto-line">
        <strong>Gastronomia e arte · Immersive · Nature Experience</strong>
        <p>
          Tre modi di vivere FLOW: una serata da condividere, due o tre giorni
          di immersione, un’uscita per conoscere il territorio e nuove persone.
        </p>
      </div>
      <section id="filosofia" class="section shell pair philosophy-section">
        <div>
          <p class="eyebrow">L’ORIGINE / UNA RICERCA PERSONALE</p>
          <h2>
            Trovare il flow.
            <br />
            <em>Esprimere il cuore.</em>
          </h2>
          <p>
            Per me FLOW comincia da quei momenti in cui attenzione e azione si
            incontrano: sono presente, coinvolto in ciò che faccio e posso
            esprimere le mie possibilità. Vorrei creare occasioni per esplorare
            questa esperienza anche insieme agli altri.
          </p>
          <p class="small">Riccardo «Rio» Vittori</p>
        </div>
        <div>
          <h3>
            Due ispirazioni.
            <br />
            Un’intenzione da vivere.
          </h3>
          <p>
            Il flow studiato da Mihály Csíkszentmihályi è un riferimento:
            coinvolgimento profondo e attenzione concentrata in un’attività, nel
            rapporto fra sfida e capacità.
          </p>
          <p>
            Laozi e il <em>wu wei</em> sono un’altra ispirazione: imparare ad
            agire senza forzare, coltivando la naturalezza. Sono prospettive
            distinte, che nella mia ricerca entrano in dialogo.
          </p>
          <p>
            <strong>Feel Your HeART</strong> custodisce il senso di questo
            incontro. Il cuore richiama ciò che sentiamo; ART, dentro HeART,
            l’arte di dargli espressione. Le esperienze FLOW sono un modo
            concreto per cominciare.
          </p>
          <a class="text-link" href={href('manifesto/')}>
            Leggi la filosofia FLOW ↗
          </a>
        </div>
      </section>
      <section id="esperienze" class="section shell">
        <div class="section-heading">
          <p class="eyebrow">01 / EXPERIENCES</p>
          <h2>
            Scegli ciò che
            <br />
            <em>ti muove.</em>
          </h2>
          <p>
            Gastronomia, pratica e natura. Tre famiglie di incontri, ciascuna
            con un pubblico, un ritmo e un programma propri. Le prime date sono
            in preparazione.
          </p>
        </div>
        <div class="pair">
          <article class="experience">
            <p class="eyebrow">LA TERRA A TAVOLA</p>
            <h3>
              Gastronomia.
              <br />
              Arte. Convivialità.
            </h3>
            <p>
              Serate intime con menu fisso, olio extravergine, tartufo e
              prodotti stagionali. Musica su vinile o dal vivo e racconti del
              territorio accompagnano la tavola. Ogni edizione ha un tema
              gastronomico, musicale o culturale.
            </p>
            <p class="small">
              Menu, sede, prezzo e inclusioni saranno definiti per ogni serata.
            </p>
            <a
              href="#contatti"
              class="text-link"
              data-interest="Degustazioni, gastronomia e arte"
            >
              Mi interessa una serata ↗
            </a>
          </article>
          <article class="experience">
            <p class="eyebrow">FLOW NATURE EXPERIENCE</p>
            <h3>
              Esplorare un luogo.
              <br />
              Incontrare persone.
            </h3>
            <p>
              Uscite brevi condivise, con posti individuali: osservazione,
              conoscenza del territorio e socialità. Un pranzo o buffet può
              completare l’incontro, come opzione con prezzo separato.
            </p>
            <p class="small">
              Percorso, difficoltà, requisiti e condizioni meteo saranno
              indicati nella proposta.
            </p>
            <a
              href="#contatti"
              class="text-link"
              data-interest="Nature Experience — uscita sociale"
            >
              Mi interessa un’uscita sociale ↗
            </a>
          </article>
        </div>
        <article class="featured experience">
          <div>
            <p class="eyebrow">IL CERCATORE / PRIVATE TRUFFLE EXPERIENCE</p>
            <h3>
              Un altro modo
              <br />
              di leggere il bosco.
            </h3>
            <p>
              Un’esperienza privata sul tartufo per piccoli gruppi, con la
              possibilità di proseguire con una degustazione o un pasto. Giorno,
              lingua e programma vengono concordati individualmente.
            </p>
            <p class="small">
              Un’offerta distinta dalle uscite sociali: nessuna garanzia di
              ritrovamento o tartufo da portare a casa incluso automaticamente.
            </p>
            <a
              href="#contatti"
              class="text-link"
              data-interest="Private Truffle Experience"
            >
              Richiedi un’esperienza privata ↗
            </a>
          </div>
          <aside lang="en">
            <p class="eyebrow">VISITING UMBRIA?</p>
            <h4>
              A private truffle experience.
              <br />
              Your group, your enquiry.
            </h4>
            <p>
              Explore the woods with a truffle hunter and dog, with an optional
              tasting or meal. Tell us your dates, group size and language. The
              location, programme, price and availability will be confirmed in
              your quotation.
            </p>
            <a
              href="#contatti"
              class="text-link"
              data-interest="Private Truffle Experience"
            >
              Plan your private experience ↗
            </a>
          </aside>
        </article>
      </section>
      <section id="percorsi" class="dark-section">
        <div class="shell pair">
          <div>
            <p class="eyebrow">02 / FLOW IMMERSIVE</p>
            <h2>
              Due o tre giorni.
              <br />
              <em>Un tempo da vivere insieme.</em>
            </h2>
            <p>
              Natura, corpo, conoscenza e vita di gruppo. Un programma
              essenziale, con movimento e principi marziali, osservazione del
              paesaggio, momenti contemplativi facoltativi e convivialità.
            </p>
            <a
              class="button light"
              href="#contatti"
              data-interest="FLOW Immersive — 2–3 giorni"
            >
              Esprimi interesse per Immersive ↗
            </a>
          </div>
          <ol class="path-steps">
            <li>
              <span>PRATICA</span>
              <h3>Corpo e presenza</h3>
              <p>
                Attività adattate al livello del gruppo, con conduzione e
                requisiti espliciti.
              </p>
            </li>
            <li>
              <span>CONOSCENZA</span>
              <h3>Natura e cultura</h3>
              <p>
                Pochi temi coerenti, approfonditi con professionisti e docenti
                pertinenti.
              </p>
            </li>
            <li>
              <span>INCONTRO</span>
              <h3>Spazio per il gruppo</h3>
              <p>
                Pause, pasti e condivisione senza obbligo di partecipare a ogni
                pratica. Sede, professionisti, date, ospitalità e prezzo sono da
                definire. L’interesse non è una prenotazione e qui non viene
                richiesto alcun pagamento.
              </p>
            </li>
          </ol>
        </div>
      </section>
      <section id="servizi" class="section shell">
        <div class="section-heading">
          <p class="eyebrow">SU RICHIESTA</p>
          <h2>
            Tartufo fresco.
            <br />
            <em>Pratica personale.</em>
          </h2>
        </div>
        <div class="pair">
          <article class="experience">
            <h3>Tartufo su ordinazione</h3>
            <p>
              Segnala specie o preferenza, quantità in grammi, località e data
              desiderata. Disponibilità, provenienza, prezzo, venditore e
              modalità di consegna saranno precisati prima di ogni eventuale
              ordine.
            </p>
            <p class="small">
              Questa è una richiesta di informazioni: nessun acquisto o
              pagamento viene concluso dal sito. Altri prodotti tipici e
              naturali sono sviluppi futuri.
            </p>
            <a
              class="text-link"
              href="#contatti"
              data-interest="Tartufo fresco su ordinazione"
            >
              Richiedi disponibilità tartufo ↗
            </a>
          </article>
          <article class="experience">
            <h3>Lezioni di arti marziali</h3>
            <p>
              Richieste per lezioni individuali o piccoli gruppi, online o in
              presenza, su appuntamento. Indica esperienza, obiettivi e
              modalità: disciplina, conduzione, requisiti e disponibilità
              saranno concordati.
            </p>
            <a
              class="text-link"
              href="#contatti"
              data-interest="Lezioni arti marziali"
            >
              Parliamo della tua pratica ↗
            </a>
          </article>
        </div>
      </section>
      <section class="section shell pair resource-section">
        <div>
          <p class="eyebrow">03 / QUALCOSA DA PORTARE CON TE</p>
          <h2>
            La curiosità continua.
            <br />
            <em>Anche dopo l’uscita.</em>
          </h2>
          <p>
            Il taccuino FLOW è una scheda gratuita per annotare osservazioni,
            domande e ciò che desideri approfondire. Puoi usarlo sullo schermo o
            stamparlo.
          </p>
          <div class="actions">
            <a class="button primary" href={href('risorse/taccuino-flow.html')}>
              Apri il taccuino gratuito ↗
            </a>
            <a class="text-link" href={href('esplora/')}>
              Leggi il taccuino online ↗
            </a>
          </div>
          <p class="small">
            Libri, video e risorse digitali sono parte del progetto in sviluppo.
            Nessun prodotto a pagamento è acquistabile da questa pagina.
          </p>
        </div>
        <div class="paper-preview" aria-hidden="true">
          <span>FLOW / TACCUINO</span>
          <h3>
            Che cosa hai
            <br />
            <em>notato oggi?</em>
          </h3>
          <div></div>
          <div></div>
          <div></div>
          <p>Osservare → domandare → approfondire</p>
        </div>
      </section>
      <section id="riccardo" class="section shell pair about-grid">
        <figure>
          <Picture
            src={portrait}
            alt="Riccardo Vittori, fondatore del progetto FLOW"
            formats={['avif', 'webp']}
            widths={[400, 700]}
            sizes="(max-width:760px) 90vw, 35vw"
            loading="lazy"
          />
        </figure>
        <div>
          <p class="eyebrow">04 / DIETRO FLOW</p>
          <h2>
            Sono Riccardo.
            <br />
            <em>Puoi chiamarmi Rio.</em>
          </h2>
          <p>
            FLOW nasce dall’incontro fra il mio interesse per la natura, la
            pratica marziale e l’esperienza nella formazione e
            nell’organizzazione di eventi.
          </p>
          <p>
            Voglio costruire incontri curati, in cui esplorare e fare esperienza
            insieme. Il tartufo è un punto di partenza concreto; il filo che
            unisce tutto è imparare facendo, con rispetto per luoghi e persone.
          </p>
          <p>
            Anche per me è un percorso in evoluzione. Parto dalle esperienze che
            posso mettere al servizio degli altri e continuo a imparare: FLOW
            cresce attraverso la pratica, gli incontri e ciò che costruiremo
            insieme.
          </p>
          <a class="text-link" href={href('chi-sono/')}>
            Il mio percorso ↗
          </a>
        </div>
      </section>
      <section id="collabora" class="section shell collaboration">
        <div class="section-heading">
          <p class="eyebrow">05 / COSTRUIRE INSIEME</p>
          <h2>
            Una buona esperienza
            <br />
            <em>ha più di una firma.</em>
          </h2>
          <p>
            FLOW cerca relazioni concrete con chi condivide attenzione per il
            territorio, qualità dell’esperienza e rispetto delle persone.
          </p>
        </div>
        <div class="collab-grid">
          <article>
            <h3>Ospita</h3>
            <p>
              Hai una struttura o un terreno adatto? Possiamo progettare
              un’esperienza coerente con il luogo, definendo ruoli, condizioni e
              responsabilità.
            </p>
          </article>
          <article>
            <h3>Condividi competenze</h3>
            <p>
              Insegnanti, professionisti della natura e custodi di tradizioni:
              un programma nasce da competenze reali e da un progetto condiviso.
            </p>
          </article>
          <article>
            <h3>Sostieni</h3>
            <p>
              Per aziende, scuole, università ed enti: proposte educative, posti
              sostenuti e collaborazioni territoriali con obiettivi e
              rendicontazione definiti.
            </p>
          </article>
        </div>
        <a
          class="text-link"
          href="#contatti"
          data-interest="Sponsor e collaborazioni"
        >
          Proponi una collaborazione ↗
        </a>
        <p class="small">
          Le collaborazioni sono da costruire: non sono dichiarati sponsor,
          affiliazioni o risultati sociali già acquisiti.
        </p>
      </section>
      <section id="restituzione" class="dark-section">
        <div class="shell pair">
          <div>
            <p class="eyebrow">PROJECTS / PRENDERSI CURA</p>
            <h2>
              Incontrare un luogo.
              <br />
              <em>Contribuire al suo futuro.</em>
            </h2>
            <p>
              La visione FLOW collega formazione esperienziale, conservazione,
              rigenerazione, solidarietà e scambio interculturale: esperienze
              che possano sostenere persone, animali e habitat, rispettando
              tradizioni, spiritualità e culture dei luoghi. Dal territorio
              vicino a collaborazioni fra Paesi: i progetti nascono con chi quei
              luoghi li vive.
            </p>
            <a
              class="button light"
              href="#contatti"
              data-interest="Partner ambientali"
            >
              Costruiamo un progetto ↗
            </a>
          </div>
          <div class="mission-copy">
            <h3>
              Un bisogno reale.
              <br />
              Un impegno leggibile.
            </h3>
            <p>
              Recupero di habitat, cura del territorio, tutela degli animali o
              iniziative educative: scegliamo interventi con responsabili,
              competenze e continuità, non soltanto un gesto durante l’evento.
            </p>
            <p>
              Quota dell’esperienza, compensi organizzativi e fondi per il
              progetto locale saranno distinti. Eventuali raccolte volontarie
              avranno beneficiario, obiettivo e rendiconto espliciti, anche per
              chi non partecipa all’esperienza.
            </p>
            <p>
              È una direzione da costruire: oggi non sono aperte raccolte fondi,
              né vengono dichiarati interventi o benefici già realizzati.
            </p>
          </div>
        </div>
      </section>
      <section id="contatti" class="section shell pair contact-grid">
        <div>
          <p class="eyebrow">07 / IL PROSSIMO PASSO</p>
          <h2>
            Da cosa
            <br />
            <em>cominciamo?</em>
          </h2>
          <p>
            Racconta che cosa ti interessa, in quanti siete e quando vorresti
            partecipare. Per sedi e collaborazioni, descrivi la tua proposta.
            Puoi segnalare interesse per i tre format o proporti come docente,
            professionista, struttura ospitante o partner ambientale.
          </p>
          <p>
            Il calendario delle prime esperienze è in preparazione. Luogo,
            prezzo, disponibilità e organizzatore saranno confermati prima di
            qualsiasi prenotazione.
          </p>
          {!ready && (
            <p class="contact-status">
              Il contatto diretto sarà disponibile a breve. Puoi già preparare e
              salvare la tua richiesta.
            </p>
          )}
        </div>
        <form
          id="interest-form"
          data-whatsapp={launchContact.whatsapp}
          data-email={launchContact.email}
        >
          <label>
            Mi interessa
            <select name="interest" id="interest">
              {interests.map((value) => (
                <option>{value}</option>
              ))}
            </select>
          </label>
          <label>
            Come ti chiami?
            <input name="name" autocomplete="name" maxlength="100" required />
          </label>
          <div class="form-row">
            <label>
              Partecipanti
              <input
                name="people"
                type="number"
                min="1"
                max="100"
                inputmode="numeric"
              />
            </label>
            <label>
              Periodo desiderato
              <input
                name="period"
                maxlength="100"
                placeholder="Es. un weekend di dicembre"
              />
            </label>
          </div>
          <fieldset id="truffle-fields" hidden>
            <legend>Tartufo fresco — dettagli della richiesta</legend>
            <label>
              Specie o preferenza
              <input
                name="species"
                maxlength="100"
                placeholder="Es. specie da consigliare"
              />
            </label>
            <label>
              Quantità in grammi
              <input
                name="grams"
                type="number"
                min="1"
                max="100000"
                inputmode="numeric"
              />
            </label>
          </fieldset>
          <fieldset id="lesson-fields" hidden>
            <legend>Lezioni — modalità e livello</legend>
            <label>
              Modalità
              <select name="mode">
                <option>Da concordare</option>
                <option>Online</option>
                <option>In presenza — individuale</option>
                <option>In presenza — gruppo</option>
              </select>
            </label>
            <label>
              Esperienza e obiettivo
              <input
                name="level"
                maxlength="200"
                placeholder="Es. principiante, lavoro sui fondamentali"
              />
            </label>
          </fieldset>
          <fieldset id="meal-fields" hidden>
            <legend>Eventuale gastronomia</legend>
            <label>
              Pasto o degustazione
              <select name="meal">
                <option>Da concordare</option>
                <option>Solo uscita</option>
                <option>Vorrei un preventivo con pasto o buffet</option>
              </select>
            </label>
          </fieldset>
          <div class="form-row">
            <label>
              Località o destinazione
              <input name="location" maxlength="150" />
            </label>
            <label>
              Lingua preferita / Preferred language
              <input
                name="language"
                maxlength="80"
                placeholder="Italiano / English"
              />
            </label>
          </div>
          <label>
            La tua richiesta
            <textarea
              name="message"
              rows="4"
              maxlength="1500"
              placeholder="Racconta cosa cerchi, senza inserire dati sanitari o sensibili."
            ></textarea>
          </label>
          <p class="small">
            La richiesta viene preparata nel tuo browser.{' '}
            {ready
              ? 'Sarai tu a inviarla tramite il contatto scelto.'
              : 'Non è inviata a FLOW: puoi copiarla o scaricarla.'}{' '}
            <a href={href('privacy/')}>Privacy</a>.
          </p>
          <button class="button primary" type="submit">
            Prepara la richiesta ↗
          </button>
          <div id="request-result" hidden>
            <label>
              Messaggio preparato
              <textarea id="request-text" rows="7" readonly></textarea>
            </label>
            <div class="actions">
              <a id="send-request" class="button primary" hidden>
                Invia il messaggio ↗
              </a>
              <button type="button" class="button secondary" id="copy-request">
                Copia
              </button>
              <button type="button" class="text-button" id="download-request">
                Salva .txt
              </button>
            </div>
          </div>
          <p id="request-status" role="status" aria-live="polite"></p>
          <noscript>
            <p>
              Il modulo richiede JavaScript. Puoi scrivere direttamente a
              Riccardo tramite
              <a
                href={`https://wa.me/${launchContact.whatsapp.replace(/\D/g, '')}`}
              >
                WhatsApp
              </a>
              , indicando esperienza, data e numero di persone.
            </p>
          </noscript>
        </form>
      </section>
    </main>
    <footer class="shell launch-footer">
      <a class="brand" href={href()}>
        FLOW<span>Natura. Corpo. Conoscenza.</span>
      </a>
      <p>
        Un progetto di Riccardo Vittori.
        <br />
        Un’identità che cresce attraverso esperienze concrete.
      </p>
      <nav aria-label="Informazioni">
        <a href={href('chi-sono/')}>Chi sono</a>
        <a href={href('privacy/')}>Privacy</a>
        <a href={href('manifesto/')}>Manifesto</a>
      </nav>
    </footer>
    <script>
      const form = document.querySelector<HTMLFormElement>('#interest-form');
      const select = document.querySelector<HTMLSelectElement>('#interest');
      const text = document.querySelector<HTMLTextAreaElement>('#request-text');
      const status = document.querySelector<HTMLElement>('#request-status');
      const syncFields = () => {
        const interest = select?.value || '';
        for (const [id, visible] of [
          ['truffle-fields', interest === 'Tartufo fresco su ordinazione'],
          ['lesson-fields', interest === 'Lezioni arti marziali'],
          [
            'meal-fields',
            interest === 'Private Truffle Experience' ||
              interest === 'Nature Experience — uscita sociale',
          ],
        ] as const) {
          const section = document.getElementById(id);
          if (section) {
            section.hidden = !visible;
            section
              .querySelectorAll<HTMLInputElement | HTMLSelectElement>(
                'input,select',
              )
              .forEach((input) => {
                input.disabled = !visible;
              });
          }
        }
      };
      select?.addEventListener('change', syncFields);
      syncFields();
      document
        .querySelectorAll<HTMLAnchorElement>('[data-interest]')
        .forEach((link) =>
          link.addEventListener('click', () => {
            if (select) select.value = link.dataset.interest || '';
            syncFields();
          }),
        );
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const d = new FormData(form);
        const details = [
          ['Località', 'location'],
          ['Lingua', 'language'],
          ['Specie/preferenza', 'species'],
          ['Grammi', 'grams'],
          ['Modalità', 'mode'],
          ['Esperienza/obiettivo', 'level'],
          ['Pasto/buffet', 'meal'],
        ]
          .filter(([, key]) => d.get(key))
          .map(([label, key]) => `${label}: ${String(d.get(key))}`)
          .join('\n');
        const message = `FLOW — ${String(d.get('interest') || '')}\nNome: ${String(d.get('name') || '')}\nPartecipanti: ${String(d.get('people') || 'da definire')}\nPeriodo/data: ${String(d.get('period') || 'da definire')}\n${details}\n\n${String(d.get('message') || '')}\n\nRichiesta di informazioni, non prenotazione né ordine. Prezzo e disponibilità da confermare.`;
        if (text) text.value = message;
        const result = document.querySelector<HTMLElement>('#request-result');
        if (result) result.hidden = false;
        const phone = (form.dataset.whatsapp || '').replace(/\D/g, '');
        const email = form.dataset.email || '';
        const send = document.querySelector<HTMLAnchorElement>('#send-request');
        if (send && (phone || email)) {
          send.href = phone
            ? `https://wa.me/${phone}?text=${encodeURIComponent(message)}`
            : `mailto:${email}?subject=${encodeURIComponent('FLOW — richiesta informazioni')}&body=${encodeURIComponent(message)}`;
          send.hidden = false;
          send.target = phone ? '_blank' : '_self';
          send.rel = 'noopener';
        }
        if (status)
          status.textContent =
            phone || email
              ? 'Messaggio preparato. Apri il contatto e invialo per farci ricevere la richiesta.'
              : 'Richiesta preparata, non inviata. Il contatto diretto non è ancora attivo: puoi copiare o salvare il testo.';
      });
      document
        .querySelector('#copy-request')
        ?.addEventListener('click', async () => {
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text.value);
            if (status)
              status.textContent =
                'Testo copiato. Nessun messaggio inviato automaticamente.';
          } catch {
            text.focus();
            text.select();
            if (status)
              status.textContent = 'Seleziona e copia il testo del messaggio.';
          }
        });
      document
        .querySelector('#download-request')
        ?.addEventListener('click', () => {
          if (!text) return;
          const url = URL.createObjectURL(
            new Blob([text.value], { type: 'text/plain;charset=utf-8' }),
          );
          const a = document.createElement('a');
          a.href = url;
          a.download = 'richiesta-flow.txt';
          a.click();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
        });
    </script>
  </body>
</html>
