---
import { priceSchema } from '../../schemas/commerce';
interface Props {
  amount: number;
  currency?: string;
}
const { amount, currency = 'EUR' } = Astro.props;
priceSchema.parse({ amount, currency });
---

<span>
  {new Intl.NumberFormat('it-IT', { style: 'currency', currency }).format(
    amount,
  )}
</span>
