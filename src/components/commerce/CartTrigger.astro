---
import { checkoutUrl as checkoutUrlSchema } from '../../schemas/commerce';
interface Props {
  checkoutUrl?: string;
}
const { checkoutUrl } = Astro.props;
if (checkoutUrl) checkoutUrlSchema.parse(checkoutUrl);
---

{checkoutUrl && (
  <a class="button" href={checkoutUrl}>
    Vai al checkout ↗
  </a>
)}
