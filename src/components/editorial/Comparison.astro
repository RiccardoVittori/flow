---
interface Props {
  caption: string;
  headers: string[];
  rows: string[][];
}
const { caption, headers, rows } = Astro.props;
---

<div class="comparison" role="region" aria-label={caption} tabindex="0">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        {headers.map((header) => (
          <th scope="col">{header}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, i) =>
            i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
