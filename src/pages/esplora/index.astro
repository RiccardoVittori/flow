---
import Base from '../../layouts/Base.astro';
import { areas } from '../../config/taxonomy';
import { href } from '../../lib/urls';
import { topicIndex } from '../../lib/topics';
import { articles } from '../../lib/content';
const [index, posts] = await Promise.all([topicIndex(), articles()]);
const publishedTopics = index.filter((topic) => topic.count > 0);
const futureTopics = index.filter((topic) => topic.count === 0);
const counts = new Map(
  areas.map((area) => [
    area.id,
    posts.filter((entry) => entry.data.category === area.id).length,
  ]),
);
---

<Base
  title="Esplora gli orizzonti — FLOW"
  description="Tartufi e bosco: i primi percorsi di FLOW. Scopri la mappa dei temi e gli orizzonti futuri."
>
  <div class="wrap">
    <header class="page-heading">
      <p class="eyebrow">L’ATLANTE FLOW</p>
      <h1>
        Tutto comincia
        <br />
        <em>da una connessione.</em>
      </h1>
      <p class="dek">
        Scegli un orizzonte. Il primo sentiero attraversa il bosco.
      </p>
    </header>
    <div class="area-grid page-body">
      {areas.map((area, i) => (
        <a class="area-item" href={href(`esplora/${area.id}/`)}>
          <span class="eyebrow">
            0{i + 1} ·{' '}
            {counts.get(area.id)
              ? `${counts.get(area.id)} ${counts.get(area.id) === 1 ? 'lettura' : 'letture'}`
              : 'In progetto'}
          </span>
          <h3>{area.title}</h3>
          <p>{area.subtitle}</p>
          <span class="area-bottom">Scopri la direzione ↗</span>
        </a>
      ))}
    </div>
    <section class="page-body" id="argomenti">
      <h2>Le domande del Cercatore</h2>
      <p class="dek">
        Scegli un argomento e ritrova le letture collegate, anche quando
        appartengono a percorsi diversi.
      </p>
      <div class="topic-list">
        {publishedTopics.map((topic) => (
          <a href={topic.url}>
            {topic.title}{' '}
            <span class="topic-count">
              {topic.count} {topic.count === 1 ? 'lettura' : 'letture'}
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      {futureTopics.length > 0 && (
        <details class="future-topics">
          <summary>Gli argomenti ancora da sviluppare</summary>
          <p>
            Fanno parte della mappa editoriale, ma non hanno ancora letture
            pubblicate.
          </p>
          <ul>
            {futureTopics.map((topic) => (
              <li>{topic.title}</li>
            ))}
          </ul>
        </details>
      )}
    </section>
  </div>
</Base>
