---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import forest from '../assets/forest.jpg';
import woods from '../assets/woods.jpg';
import { href } from '../lib/urls';
import { articles } from '../lib/content';
import { areas } from '../config/taxonomy';
import StoryCard from '../components/editorial/StoryCard.astro';
const posts = await articles();
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <Picture
      class="hero-photo"
      src={forest}
      alt="Luce naturale tra i tronchi e il sottobosco di una foresta"
      widths={[640, 960, 1440, 1920, 2200]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="hero-content wrap">
      <p class="eyebrow">
        <span class="small-line"></span> Natura. Conoscenza. Connessioni.
      </p>
      <h1 id="hero-title">
        C’è un mondo.
        <br />
        <em>Impara a leggerlo.</em>
      </h1>
      <div class="hero-bottom">
        <p>
          Ogni sentiero comincia con una domanda.
          <br />
          Il nostro, dall’incontro con il bosco.
        </p>
        <a class="button button-light" href={href('il-cercatore/')}>
          Entra nel mondo del Cercatore <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <span class="hero-side">FIELD JOURNAL — VOL. 01 / IL BOSCO</span>
    <div class="hero-caption wrap">
      <span>01 — Il punto di partenza</span>
      <a href="#orizzonti">Scorri per esplorare ↓</a>
    </div>
  </section>
  <section class="intro wrap section" id="orizzonti">
    <p class="eyebrow section-label">
      IL MONDO FLOW <span>↘</span>
    </p>
    <div>
      <h2>
        La conoscenza cresce
        <br />
        dove le cose <em>si incontrano.</em>
      </h2>
      <div class="intro-bottom">
        <p>
          Tra natura e cultura. Tra quello che sappiamo e quello che dobbiamo
          ancora scoprire. FLOW è uno spazio per osservare, fare domande e
          tornare a sentirsi parte del paesaggio.
        </p>
        <a class="text-link" href={href('manifesto/')}>
          La nostra direzione ↗
        </a>
      </div>
    </div>
  </section>
  <section class="feature wrap section">
    <div class="feature-photo">
      <Picture
        src={woods}
        alt="Bosco di conifere riflesso in un lago, con rilievi sullo sfondo"
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 100vw, 50vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
      <span class="photo-label">IL PRIMO CAPITOLO DI FLOW</span>
    </div>
    <div class="feature-copy">
      <p class="eyebrow">01 / IL CERCATORE</p>
      <h2>
        Il bosco non
        <br />
        rivela tutto.
        <br />
        <em>
          Ci insegna
          <br />a osservare.
        </em>
      </h2>
      <p>
        Tartufi, natura e arte di leggere il bosco. Un percorso che parte da ciò
        che non vediamo, per cambiare il modo in cui guardiamo tutto il resto.
      </p>
      <a class="text-link" href={href('il-cercatore/')}>
        Scopri Il Cercatore <span aria-hidden="true">↗</span>
      </a>
      <div class="tags">
        <span>TARTUFI</span>
        <span>ECOLOGIA</span>
        <span>CULTURA DEL BOSCO</span>
      </div>
    </div>
  </section>
  <section class="explore-section section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CONNESSIONI, NON CONFINI</p>
          <h2>
            Segui la tua <em>curiosità.</em>
          </h2>
        </div>
        <a class="text-link" href={href('esplora/')}>
          Tutti gli orizzonti ↗
        </a>
      </div>
      <div class="area-grid">
        {areas.slice(0, 4).map((area, i) => (
          <a class="area-item" href={href(`esplora/${area.id}/`)}>
            <span class="area-number">0{i + 1}</span>
            <h3>{area.title}</h3>
            <p>{area.subtitle}</p>
            <span class="area-bottom">
              {area.active ? 'Esplora il percorso' : 'Orizzonte futuro'}{' '}
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">DAL TACCUINO</p>
        <h2>
          Prendere nota.
          <br />
          <em>Andare più a fondo.</em>
        </h2>
      </div>
      <a class="text-link" href={href('taccuino/')}>
        Tutte le letture ↗
      </a>
    </div>
    <div class="stories-grid">
      {posts.slice(0, 3).map((entry, index) => (
        <StoryCard entry={entry} index={index} />
      ))}
    </div>
  </section>
  <section class="field-band">
    <div class="wrap field-content">
      <p class="eyebrow">
        APPUNTO N. 001
        <br />
        UN INVITO ALL’ATTENZIONE
      </p>
      <blockquote>
        Prima di cercare qualcosa,
        <br />
        <em>impariamo a esserci.</em>
      </blockquote>
      <span class="field-symbol" aria-hidden="true">
        ↗
      </span>
    </div>
  </section>
  <section class="wrap section book-section">
    <div
      class="book-art"
      aria-label="Studio grafico della copertina, non definitiva"
    >
      <div class="book-cover">
        <span>FLOW / BIBLIOTECA</span>
        <strong>
          IL
          <br />
          CERCATORE
        </strong>
        <span>
          Tartufi, natura e arte
          <br />
          di leggere il bosco
        </span>
        <div class="book-lines" aria-hidden="true"></div>
        <small>RICCARDO VITTORI</small>
      </div>
      <span class="book-caption">STUDIO DI COPERTINA · PROGETTO IN CORSO</span>
    </div>
    <div>
      <p class="eyebrow">DAL BOSCO, ALLA PAGINA</p>
      <h2>
        La ricerca continua.
        <br />
        <em>Anche sulla carta.</em>
      </h2>
      <p>
        Il Cercatore è anche un progetto editoriale in lavorazione. Un libro per
        mettere in relazione osservazioni, domande e conoscenze.
      </p>
      <p class="muted">La data di uscita non è ancora annunciata.</p>
      <a class="text-link" href={href('il-cercatore/#libro')}>
        Conosci il progetto del libro ↗
      </a>
    </div>
  </section>
  <section class="wrap future-strip">
    <p class="eyebrow">I PROSSIMI ORIZZONTI</p>
    <a href={href('esplora/esperienze/')}>
      Esperienze nella natura <span>↗</span>
    </a>
    <a href={href('esplora/pratiche/')}>
      Corpo, presenza, pratiche <span>↗</span>
    </a>
    <a href={href('esplora/viaggi/')}>
      Territori da conoscere <span>↗</span>
    </a>
  </section>
  <section class="newsletter wrap section">
    <p class="eyebrow">RESTIAMO IN CAMMINO</p>
    <h2>
      Una nuova pagina.
      <br />
      <em>Quando c’è qualcosa da raccontare.</em>
    </h2>
    <p>
      Segui le nuove letture con il feed RSS, senza algoritmi.
      <br />
      La newsletter via email arriverà più avanti.
    </p>
    <a class="button" href={href('rss.xml')}>
      Segui il taccuino via RSS <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
