---
import Base from '../layouts/Base.astro';
import { href } from '../lib/urls';
---

<Base title="Sentiero non trovato — FLOW" noindex>
  <section class="wrap section">
    <p class="eyebrow">404 · FUORI SENTIERO</p>
    <h1>
      Qui il sentiero
      <br />
      <em>si interrompe.</em>
    </h1>
    <p class="dek">
      La pagina non esiste o ha cambiato indirizzo. Ripartiamo da una nuova
      domanda.
    </p>
    <a class="text-link" href={href('esplora/')}>
      Torna a esplorare ↗
    </a>
  </section>
</Base>
