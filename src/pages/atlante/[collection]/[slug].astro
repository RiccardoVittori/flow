---
import Base from '../../../layouts/Base.astro';
import { knowledgeEntries } from '../../../lib/knowledge';
import { render } from 'astro:content';
export async function getStaticPaths() {
  return (await knowledgeEntries()).map((entry) => ({
    params: { collection: entry.collection, slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} — Atlante FLOW`}
  description={entry.data.description}
>
  <article class="wrap" data-pagefind-body>
    <header class="page-heading">
      <p class="eyebrow">ATLANTE · {entry.collection}</p>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="dek">{entry.data.description}</p>
    </header>
    <div class="prose page-body">
      <Content />
      <p>
        {entry.data.scientificNames.map((name) => (
          <i lang="la">{name} </i>
        ))}
      </p>
      {entry.data.sources.length > 0 && (
        <section>
          <h2>Fonti</h2>
          <ul>
            {entry.data.sources.map((source) => (
              <li>
                <a href={source.url}>{source.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</Base>
