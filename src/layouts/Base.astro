---
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/fonts.css';
import { href, absolute } from '../lib/urls';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  title = 'FLOW — Natura, conoscenza, esplorazione',
  description = 'Un progetto editoriale per esplorare la natura, coltivare attenzione e mettere in relazione le conoscenze. Il viaggio comincia dal bosco.',
  image = absolute('social.jpg'),
  article = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname.endsWith('/404/')
    ? Astro.url.pathname.replace(/404\/$/, '404.html')
    : Astro.url.pathname,
  Astro.site,
).href;
const nav = [
  ['Esplora', 'esplora/'],
  ['Il Cercatore', 'il-cercatore/'],
  ['Il progetto', 'manifesto/'],
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f3f0e8" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta
      property="og:image:alt"
      content="FLOW — esplorare, conoscere, connettere"
    />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="FLOW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Il taccuino FLOW"
      href={href('rss.xml')}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'FLOW',
        url: absolute(),
        logo: absolute('favicon.svg'),
      }).replace(/</g, '\\u003c')}
    ></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      Vai al contenuto
    </a>
    <header class="header wrap">
      <a class="wordmark" href={href()} aria-label="FLOW, homepage">
        FLOW
        <span class="brand-dot" aria-hidden="true">
          ○
        </span>
      </a>
      <span class="brand-caption">
        A WAY OF
        <br />
        EXPLORING LIFE
      </span>
      <nav class="desktop-nav" aria-label="Navigazione principale">
        {nav.map(([label, path]) => (
          <a
            href={href(path)}
            aria-current={
              Astro.url.pathname === href(path) ? 'page' : undefined
            }
          >
            {label}
          </a>
        ))}
      </nav>
      <a
        class="search-link"
        aria-label="Cerca nel mondo FLOW"
        href={href('cerca/')}
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 5 5" />
        </svg>
        <span>Cerca</span>
      </a>
      <details class="mobile-nav">
        <summary>
          Menu <span aria-hidden="true">＋</span>
        </summary>
        <nav aria-label="Navigazione mobile">
          {nav.map(([label, path]) => (
            <a href={href(path)}>{label}</a>
          ))}
        </nav>
      </details>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-top">
        <a class="wordmark" href={href()}>
          FLOW
        </a>
        <p>
          Seguire la curiosità.
          <br />
          Ritrovare le connessioni.
        </p>
        <a class="text-link" href={href('manifesto/')}>
          Il nostro manifesto <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="wrap footer-bottom">
        <span>
          © {new Date().getFullYear()} FLOW · Un progetto di Riccardo Vittori
        </span>
        <nav aria-label="Informazioni">
          <a href={href('chi-sono/')}>Chi sono</a>
          <a href={href('privacy/')}>Privacy</a>
          <a href={href('crediti/')}>Crediti</a>
          <a href={href('rss.xml')}>RSS ↗</a>
        </nav>
        <span>Fatto per esplorare, con calma.</span>
      </div>
    </footer>
  </body>
</html>
